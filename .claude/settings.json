{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardas.py\" ] || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardas.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar_edicion.py\" ] || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar_edicion.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
