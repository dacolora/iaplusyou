.env
client_secret_youtube.json
token_youtube.json
token_tiktok.json
salidas/
registro_generaciones.csv
estado_videos.json
usuarios.json
venv/
__pycache__/
*.pyc

# Multi-cliente: credenciales y tokens por empresa nunca se versionan
clientes/*/.env
clientes/*/token_youtube.json
clientes/*/token_tiktok.json
clientes/*/estado_videos.json
clientes/*/prompts_pendientes.json
clientes/*/conceptos_pendientes.json
clientes/*/swaps.json
clientes/*/ads.json
clientes/*/meta.json
clientes/*/meta.pendiente.json
clientes/*/meta_app.json
clientes/*/referencias_flowplus/
clientes/*/logos/
clientes/*/referencias_pendientes.json
clientes/*/meta.json.tmp
clientes/*/meta.pendiente.json.tmp
clientes/*/meta_app.json.tmp
clientes/*/creative_flow_pendientes.json
clientes/*/marca.json

# Scratch de subagent-driven-development (ledgers, briefs, reports) — nunca
# es código, y guarda texto libre de subagentes que no debe versionarse.
.superpowers/sdd/

# Las imágenes/videos de cada cliente ya quedan respaldadas en R2;
# no hace falta duplicarlas (ni son código) en el repo.
clientes/*/personajes/*
!clientes/*/personajes/.gitkeep
clientes/*/escenas/*
!clientes/*/escenas/.gitkeep
clientes/*/productos_referencia/*
!clientes/*/productos_referencia/.gitkeep
clientes/*/marca/*
!clientes/*/marca/.gitkeep
# Excepción: el sistema de marca formal SÍ se versiona a propósito — es la fuente
# de verdad del cliente (ej. Happyflops), tiene que vivir en git para nunca desalinearse.
!clientes/*/marca/root.json
!clientes/*/marca/schema.json

# Catálogo de Crear (productos con sus colores, personajes y entornos): una
# sync de tienda baja cientos de fotos por proyecto y el worker reescribe las
# metas, así que nada NUEVO de aquí entra a git. OJO: lo de happyflops que ya
# estaba comprometido (productos.json y las fotos de horiginal/happyblanket)
# sigue rastreado a propósito — sacarlo del índice (git rm --cached) lo
# borraría del VPS en el próximo `git pull`.
clientes/*/productos/
clientes/*/productos.json
clientes/*/personajes_catalogo/
clientes/*/personajes_catalogo.json
clientes/*/entornos/
clientes/*/entornos.json

data/

# Archivos CSV/XLSX subidos para importar (precios del cliente); la tarea los borra al terminar
clientes/*/importaciones/

# Referencias subidas a los sprints (imágenes/videos + fotogramas); viven en R2, la copia local es caché
clientes/*/sprints/

# Subidas del editor a medio procesar (final_edition/biblioteca.py las borra al terminar; el archivo vive en R2)
clientes/*/tmp_editor/

# worktrees de superpowers / Claude Code
.claude/worktrees/
.superpowers/

# Medios sintéticos de sembrar_edicion_demo.py (vista previa local, sin R2)
static/editor_demo/

# Candado de estado.modificar (flock): varios hilos del worker y Flask escriben estado_videos.json.
clientes/*/estado_videos.json.lock
estado_videos.json.lock

# Grabaciones de voz y canciones subidas, de paso por el disco (se borran solas al terminar).
clientes/*/tmp_voces/
clientes/*/tmp_musica/
