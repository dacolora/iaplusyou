# --- Higgsfield ---
HF_API_KEY_ID=tu_key_id_aqui
HF_API_KEY_SECRET=tu_key_secret_aqui

# --- Anthropic (genera los 5 prompts por idea desde el dashboard) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Gemini (Nano Banana / gemini-2.5-flash-image, proveedor de imagen) ---
# Consíguela en aistudio.google.com/apikey (necesita facturación activada, ver ROADMAP.md)
GEMINI_API_KEY=

# --- fal.ai (Seedance 2.0, Kling O1, Luma Ray3 Modify, Wan-2.2 Animate Replace y
# los modelos de comparación de imagen) ---
# Registro simple en fal.ai, sin verificación de negocio. Dashboard > API Keys.
FAL_KEY=

# --- WaveSpeed AI (Wan 2.7 Video Edit, para "cambiar calzado" en video) ---
# wavespeed.ai > API Keys.
WAVESPEED_API_KEY=

# --- Cloudflare R2 (storage propio y permanente de cada video) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Interruptores: qué plataformas publicar por defecto (true/false) ---
# Un brief individual puede sobreescribir esto con su propio campo "platforms".
ENABLE_YOUTUBE=true
ENABLE_FACEBOOK=true
ENABLE_INSTAGRAM=true
ENABLE_TIKTOK=true

# --- YouTube ---
# No necesita variables aquí: usa client_secret_youtube.json + token_youtube.json
# generados por auth/auth_youtube.py (ver SETUP.md).

# --- Meta (Facebook + Instagram + Ads) ---
# Aquí NO van credenciales de Meta. Cada proyecto trae su propia app de Meta
# (id, secret y configuración de Facebook Login for Business) y la registra
# desde FlowMarketing; queda en clientes/<cliente>/meta_app.json. Los tokens,
# cuenta publicitaria, Página e Instagram quedan en clientes/<cliente>/meta.json.
# Lo único compartido es la URL de vuelta, que cada proyecto registra tal cual
# en su app ("Valid OAuth Redirect URIs"). Producción: la URL HTTPS real.
# Local: http://localhost:5050/meta/callback (la app debe tener "Aplicar HTTPS"
# apagado para aceptarla).
META_REDIRECT_URI=http://localhost:5050/meta/callback

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# token_tiktok.json lo genera auth/auth_tiktok.py

# --- MercadoLibre (motor de ecommerce: conectar tienda MELI) ---
# App creada en developers.mercadolibre.com (tipo "Aplicación" con permisos
# read/offline_access). En "URI de redirect" pon exactamente
# https://app.creatvmachine.com/meli/callback. Cada tienda se conecta desde el
# dashboard (OAuth) y sus tokens quedan cifrados en la base de datos.
MELI_APP_ID=
MELI_SECRET=

# --- Nicho: fuentes de comentarios (opcionales; sin ellas Nicho funciona con
# texto pegado y CSV). Se leen al usarlas; nunca salen a la interfaz. ---
# Reddit: app tipo "script" en https://www.reddit.com/prefs/apps (gratis para
# uso no comercial, 100 llamadas por minuto; uso comercial requiere permiso de
# Reddit). El user agent debe describir la app, ej. "creatv-machine/1.0 (by u/tu_usuario)".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# YouTube Data API v3: llave simple (no OAuth) creada en Google Cloud con la
# API habilitada. search.list tiene cupo de 100 llamadas por día por proyecto.
YOUTUBE_API_KEY=
# Apify (Amazon y TikTok, de pago por resultado): https://console.apify.com/account/integrations
APIFY_TOKEN=

# --- Correo de avisos del motor (opcional) ---
# Si se configura, el motor manda un correo al proyecto (Configuración >
# correo de notificaciones) cuando hay propuestas pendientes, un ganador, un
# anuncio rechazado por Meta o un lanzamiento fallido. Sin SMTP_HOST solo
# queda el registro en la bitácora. STARTTLS en el puerto 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Servidor ---
# FLASK_DEBUG=true reactiva el debugger interactivo de Werkzeug — cómodo en
# tu laptop, pero un hueco de seguridad grave en cualquier servidor accesible
# desde fuera. Déjalo SIN definir (o en false) en el VPS.
FLASK_DEBUG=false
# Clave fija para que las sesiones (login) sobrevivan un reinicio del proceso.
# Sin esto, cada arranque genera una al azar y cierra la sesión de todos.
# Generarla: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# URL pública fija del sitio (sin barra final). Es la base de los enlaces que
# van por correo (confirmar cuenta, restablecer contraseña) — nunca se toma de
# la cabecera Host de la petición, que la manda el cliente — y el único host
# que el servidor atiende (otro Host responde 404; localhost siempre pasa).
# Con https también marca la cookie de sesión como Secure. Sin definir, los
# enlaces usan el host de META_REDIRECT_URI o http://127.0.0.1:5050 (local).
# Producción: https://app.creatvmachine.com
PLATAFORMA_URL=
# Poner en 1 SOLO cuando nginx (u otro proxy) está delante de gunicorn y es lo
# único que le llega: entonces la IP y el esquema reales se leen de
# X-Forwarded-For / X-Forwarded-Proto (el último valor, el que pone nginx).
# En local o con gunicorn expuesto directo, déjalo vacío: cualquiera podría
# inventar esas cabeceras y saltarse los límites por IP.
DETRAS_DE_PROXY=
