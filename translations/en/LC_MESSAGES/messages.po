msgstr "“%(nombre)s” has %(que)s not posted organically: post it from the piece (Post organically)."

#, python-format
msgid "«%(nombre)s» ya está en el catálogo con %(n)s foto(s)."
msgstr "“%(nombre)s” is already in the catalog with %(n)s photo(s)."

#, python-format
msgid "«%(nombre)s»: lanzando a Meta en pausa. Cuando termine, actívalo desde su tarjeta."
msgstr "“%(nombre)s”: launching to Meta paused. When it's done, activate it from its card."

msgid "«Crear credenciales» › «Clave de API»; en «Restricciones de API» limítala a YouTube Data API v3."
msgstr "“Create credentials” › “API key”; in “API restrictions” limit it to YouTube Data API v3."

#, python-format
msgid "¿Archivar «%(nombre)s»? No se borra: se oculta de la lista y la sincronización de la tienda no lo vuelve a mostrar (lo recuperas desde «Mostrar archivados»)."
msgstr "Archive “%(nombre)s”? It doesn't get deleted: it's hidden from the list and the store sync won't show it again (you get it back from “Show archived”)."

#, python-format
msgid "¿Borrar «%(nombre)s» de Mi música? Los videos ya hechos conservan su audio."
msgstr "Delete “%(nombre)s” from My music? Videos already made keep their audio."

msgid "¿Cambiar de forma? Tu conexión actual sigue viva hasta que conectes por la agencia; ahí queda guardada como respaldo."
msgstr "Change form? Your current connection stays alive until you connect through the agency; then it's kept as a backup."

msgid "¿Cuánto y por cuánto tiempo?"
msgstr "How much and for how long?"

msgid "¿Cómo quieres conectar Meta?"
msgstr "How do you want to connect Meta?"

msgid "¿Descartar esta pieza?"
msgstr "Discard this piece?"

msgid "¿Desconectar Meta de este proyecto? No se borra nada en Meta."
msgstr "Disconnect Meta from this project? Nothing gets deleted on Meta."

msgid "¿Desconectar Triple Whale? Se quita la atribución por este canal."
msgstr "Disconnect Triple Whale? Attribution through this channel is removed."

msgid "¿Desconectar esta tienda? Sus productos quedan archivados; no se borra nada en la tienda."
msgstr "Disconnect this store? Its products get archived; nothing is deleted in the store."

msgid "¿Dónde se prueban?"
msgstr "Where are they tested?"

#, python-format
msgid "¿Eliminar %(nombre)s? Esto no afecta ideas ya generadas con él, pero no podrás volver a usarlo."
msgstr "Delete %(nombre)s? This doesn't affect ideas already generated with it, but you won't be able to use it again."

msgid "¿Eliminar este producto?"
msgstr "Delete this product?"

#, python-format
msgid "¿Marcar a %(usuario)s como verificado sin que abra el enlace del correo?"
msgstr "Mark %(usuario)s as verified without them opening the email link?"

msgid "¿No sabes qué escribir?"
msgstr "Not sure what to write?"

#, python-format
msgid "¿No tienes proyecto todavía? <a href=\"%(url)s\">Crea uno en un minuto</a>."
msgstr "Don't have a project yet? <a href=\"%(url)s\">Create one in a minute</a>."

msgid "¿Olvidaste tu contraseña?"
msgstr "Forgot your password?"

msgid "¿Por qué?"
msgstr "Why?"

msgid "¿Prefieres que Creatv lo gestione? Cambiar"
msgstr "Prefer that Creatv manage it? Change"

msgid "¿Prefieres usar tu propia app? Cambiar"
msgstr "Prefer to use your own app? Change"

msgid "¿Quitar de la lista?"
msgstr "Remove from the list?"

msgid "¿Quitar de la lista? Esto NO borra el anuncio en Meta si ya se publicó."
msgstr "Remove from the list? This does NOT delete the ad on Meta if it was already published."

msgid "¿Quitar este logo?"
msgstr "Remove this logo?"

msgid "¿Quitar la app de Meta de este proyecto? Tendrás que registrarla de nuevo para volver a conectar."
msgstr "Remove this project's Meta app? You'll have to register it again to reconnect."

msgid "¿Quitar todas las referencias?"
msgstr "Remove all references?"

msgid "¿Seguro? Toca otra vez"
msgstr "Sure? Tap again"

