{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happyflops.com/schema/submundo.schema.json",
  "title": "Happy Flops Tree Node (v0.8)",
  "description": "A node in the Happy Flops tree. Six levels, bottom to top: RAIZ (the matrix — 100 questions, brand DNA) / TRONCO (the matrix's references — evidence of the DNA; may nudge the root a LITTLE, only in agreement with it) / CATEGORIA (lifestyle, photoshoot, render_3d) / SUBCATEGORIA (lifestyle: exterior, interior — each with seasons; photoshoot: navidad, pelicula, colaboraciones, producto; render_3d: happy_universe) / TIPO DE CONTENIDO (ads, fotografia, video, social) / HOJA (the finished piece). Higher levels inherit and may narrow; none may weaken an invariant.",
  "type": "object",
  "required": [
    "id",
    "name",
    "layer",
    "inherits",
    "purpose"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(trunk|cat|sub|tipo)\\.[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "0.1.0"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "layer": {
      "enum": [
        "trunk",
        "category",
        "subcategory",
        "content_type"
      ],
      "description": "trunk = the matrix's references, evidence of the DNA. category = lifestyle / photoshoot / render_3d — these ARE the positioning: lifestyle is life, render_3d is imagination, photoshoot is the bridge. subcategory = the variation inside a category, including season. content_type = ads / fotografia / video / social. Precedence: content_type > subcategory > category > trunk > root."
    },
    "root": {
      "const": "happyflops.root",
      "description": "One root only. 3D is a CATEGORY now, not a sibling root — which removes the risk of two roots drifting apart."
    },
    "inherits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Stack this sits on, root first."
    },
    "purpose": {
      "type": "string"
    },
    "contexts": {
      "type": "array",
      "items": {
        "enum": [
          "branding",
          "brand_to_sell",
          "product_sell"
        ]
      }
    },
    "overrides": {
      "type": "object",
      "description": "Free variables only. Anything omitted inherits from the layer below.",
      "additionalProperties": false,
      "properties": {
        "moment": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "scenario": {
          "type": "array",
          "items": {
            "enum": [
              "exterior",
              "interior",
              "studio",
              "mixed_reality"
            ]
          }
        },
        "season": {
          "type": "array",
          "items": {
            "enum": [
              "spring",
              "summer",
              "autumn",
              "winter_outdoor",
              "winter_indoor",
              "not_applicable"
            ]
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dominant": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            }
          }
        },
        "saturation": {
          "type": "string"
        },
        "format": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "composition": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "energy": {
          "type": "string"
        },
        "styling": {
          "type": "string"
        },
        "hero_angle": {
          "type": "string"
        },
        "products_in_play": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "variants": {
      "type": "object",
      "description": "Named sub-variants inside this world — typically the four seasons for Exterior and Casa. Each variant may set the same free variables as overrides.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "light": {
            "type": "string"
          },
          "palette": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dominant": {
                "type": "string"
              },
              "accent": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              }
            }
          },
          "moment": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "styling": {
            "type": "string"
          },
          "energy": {
            "type": "string"
          },
          "products_in_play": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Reference images. For a TRUNK node these ARE the node — a trunk collection is its references. For a world or campaign they define the look. A node without references is a hypothesis, not a node.",
      "items": {
        "type": "object",
        "required": [
          "file",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "role": {
            "enum": [
              "product",
              "scene",
              "light",
              "colour",
              "composition",
              "styling",
              "mood"
            ]
          },
          "note": {
            "type": "string"
          },
          "approved": {
            "type": "boolean",
            "default": false
          },
          "analysis": {
            "type": "object",
            "additionalProperties": false,
            "description": "The attribute analysis. Fill the object matching this reference's role. This is what makes a trunk collection usable — a filename and a tag are not a reference.",
            "properties": {
              "luz": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "works_because",
                  "serves",
                  "direction",
                  "quality",
                  "source"
                ],
                "properties": {
                  "direction": {
                    "type": "string",
                    "description": "Where the light comes from"
                  },
                  "direction_readable": {
                    "type": "boolean",
                    "description": "Can you tell where it comes from? Invariant 1 requires yes."
                  },
                  "quality": {
                    "type": "string",
                    "description": "Hard or soft, and how soft"
                  },
                  "source": {
                    "type": "string",
                    "description": "window, low sun, lamp, overcast, bounce"
                  },
                  "time": {
                    "type": "string"
                  },
                  "season": {
                    "type": "string"
                  },
                  "works_because": {
                    "type": "string",
                    "description": "One concrete line. Not 'it's nice' — what specifically works."
                  },
                  "serves": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "hogar",
                        "street",
                        "naturaleza",
                        "outfits",
                        "photoshoot",
                        "characters"
                      ]
                    },
                    "minItems": 1,
                    "description": "Which worlds this reference is usable in."
                  }
                }
              },
              "felicidad": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "works_because",
                  "serves",
                  "action",
                  "where_it_shows",
                  "energy"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "What the person is actually DOING. The action, not the emotion."
                  },
                  "where_it_shows": {
                    "type": "string",
                    "description": "Eyes, hands, shoulders, posture, movement. Be specific."
                  },
                  "who": {
                    "type": "string",
                    "description": "alone / two people / family / across generations"
                  },
                  "energy": {
                    "type": "string",
                    "description": "quiet warmth <-> full movement"
                  },
                  "works_without_product": {
                    "type": "boolean",
                    "description": "Would this still feel warm with no product in it? If false, it is not a felicidad reference."
                  },
                  "performed": {
                    "type": "boolean",
                    "description": "true = it LOOKS happy and feels fake. Keep these — the opposite list is half the collection."
                  },
                  "works_because": {
                    "type": "string",
                    "description": "One concrete line. Not 'it's nice' — what specifically works."
                  },
                  "serves": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "hogar",
                        "street",
                        "naturaleza",
                        "outfits",
                        "photoshoot",
                        "characters"
                      ]
                    },
                    "minItems": 1,
                    "description": "Which worlds this reference is usable in."
                  }
                }
              },
              "poses": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "works_because",
                  "serves",
                  "body"
                ],
                "properties": {
                  "body": {
                    "type": "string",
                    "description": "How the body sits, stands, steps"
                  },
                  "why_unposed": {
                    "type": "string",
                    "description": "What specifically makes it read as caught rather than arranged"
                  },
                  "works_because": {
                    "type": "string",
                    "description": "One concrete line. Not 'it's nice' — what specifically works."
                  },
                  "serves": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "hogar",
                        "street",
                        "naturaleza",
                        "outfits",
                        "photoshoot",
                        "characters"
                      ]
                    },
                    "minItems": 1,
                    "description": "Which worlds this reference is usable in."
                  }
                }
              },
              "modelos": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "works_because",
                  "serves",
                  "register"
                ],
                "properties": {
                  "age_range": {
                    "type": "string"
                  },
                  "register": {
                    "type": "string",
                    "description": "The specific kind of real — not 'diverse', but what kind of face and presence"
                  },
                  "works_because": {
                    "type": "string",
                    "description": "One concrete line. Not 'it's nice' — what specifically works."
                  },
                  "serves": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "hogar",
                        "street",
                        "naturaleza",
                        "outfits",
                        "photoshoot",
                        "characters"
                      ]
                    },
                    "minItems": 1,
                    "description": "Which worlds this reference is usable in."
                  }
                }
              },
              "imperfecciones": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "works_because",
                  "serves",
                  "kind",
                  "what_it_is"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "alive",
                      "sloppy"
                    ],
                    "description": "THE distinction. A creased shirt says 'real home'; a badly lit background says 'bad work'. Feeling over perfection covers the first, never the second."
                  },
                  "what_it_is": {
                    "type": "string"
                  },
                  "works_because": {
                    "type": "string",
                    "description": "One concrete line. Not 'it's nice' — what specifically works."
                  },
                  "serves": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "hogar",
                        "street",
                        "naturaleza",
                        "outfits",
                        "photoshoot",
                        "characters"
                      ]
                    },
                    "minItems": 1,
                    "description": "Which worlds this reference is usable in."
                  }
                }
              },
              "material": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "works_because",
                  "serves",
                  "surface_read"
                ],
                "properties": {
                  "surface_read": {
                    "type": "string",
                    "description": "How the foam reads: matte, softly cushioned, no gloss, slight give. Never call it EVA in any output."
                  },
                  "works_because": {
                    "type": "string",
                    "description": "One concrete line. Not 'it's nice' — what specifically works."
                  },
                  "serves": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "hogar",
                        "street",
                        "naturaleza",
                        "outfits",
                        "photoshoot",
                        "characters"
                      ]
                    },
                    "minItems": 1,
                    "description": "Which worlds this reference is usable in."
                  }
                }
              }
            }
          },
          "illustrates": {
            "description": "What this reference is evidence FOR. Either a numbered invariant (1-11) or a named root principle. Not every trunk attribute maps to a numbered invariant: felicidad illustrates the brand thesis, imperfecciones illustrates feeling over perfection.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 11,
                "description": "Invariant number. luz=1 · colour=2,3 · feet=4 · product fidelity=6 · casting/poses/modelos=7 · hands=11"
              },
              {
                "enum": [
                  "feeling_over_perfection",
                  "brand_thesis_moments",
                  "between_life_and_imagination",
                  "smiletech_bend"
                ],
                "description": "Named root principles. feeling_over_perfection = imperfecciones. brand_thesis_moments = felicidad, 'we sell moments not sandals'. between_life_and_imagination = the positioning. smiletech_bend = the flex."
              }
            ]
          },
          "verdict": {
            "enum": [
              "exemplar",
              "rejected"
            ],
            "description": "exemplar = this is what the invariant looks like, keep it. rejected = it breaks the invariant it should illustrate, keep it in the NO pile. A reference with hard flat light is not another kind of light in the library — it is a rejected reference."
          },
          "rejected_because": {
            "type": "string",
            "description": "Required reasoning when verdict is rejected. Which invariant it breaks and how."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "rejected"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "required": [
                "rejected_because"
              ]
            }
          }
        ]
      }
    },
    "prompt_additions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra prompt lines. Additive only — must not contradict an invariant."
    },
    "negative_additions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra negative terms for this world. The root negative prompt is always applied first and in full."
    },
    "negative_exclusions": {
      "type": "array",
      "description": "Root negative terms this world lifts. Needed by worlds like Creative Photoshoot, which requires the seamless backdrop the root forbids. LOCKED TERMS CANNOT BE LIFTED — anything protecting feet, text or character IP is rejected by this schema.",
      "items": {
        "type": "string"
      },
      "not": {
        "contains": {
          "enum": [
            "extra toes",
            "missing toes",
            "six toes",
            "fused toes",
            "merged toes",
            "splayed toes",
            "curled toes",
            "gripping toes",
            "tense toes",
            "deformed feet",
            "malformed foot anatomy",
            "extreme toe close-up",
            "dirty feet",
            "cracked skin",
            "dry skin",
            "calluses",
            "long toenails",
            "coloured nail polish",
            "veiny feet",
            "text",
            "lettering",
            "words",
            "logo",
            "watermark",
            "signage",
            "captions",
            "cartoon characters",
            "licensed characters",
            "mascots"
          ]
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branding": {
          "type": "integer",
          "minimum": 0
        },
        "brand_to_sell": {
          "type": "integer",
          "minimum": 0
        },
        "product_sell": {
          "type": "integer",
          "minimum": 0
        },
        "cadence": {
          "type": "string"
        }
      }
    },
    "qa_additions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "blocked",
              "needed",
              "proposed",
              "done"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "invariants": {
      "not": {},
      "description": "FORBIDDEN. Invariants live in the root only. A submundo that declares this key is invalid — that is the whole point of this schema."
    },
    "root_feedback": {
      "type": "array",
      "description": "Issues this world found in the ROOT matrix. Reporting only — a submundo can never change the root. Mirrors the Matrix Feedback database in Notion. Omit entirely when nothing is wrong; do not manufacture entries.",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "type",
          "severity",
          "targets",
          "evidence",
          "proposed_change",
          "blast_radius",
          "recommendation"
        ],
        "additionalProperties": false,
        "properties": {
          "issue": {
            "type": "string"
          },
          "type": {
            "enum": [
              "blocks_the_world",
              "root_is_silent",
              "root_contradicts_itself",
              "reality_says_otherwise"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "friction",
              "note"
            ]
          },
          "targets": {
            "type": "string",
            "description": "Which invariant id or question number"
          },
          "evidence": {
            "type": "string"
          },
          "proposed_change": {
            "type": "string",
            "description": "The smallest edit that would fix it"
          },
          "blast_radius": {
            "type": "string",
            "description": "What else in the system shifts if accepted"
          },
          "recommendation": {
            "type": "string",
            "description": "The chat's own view, including 'do not change this'"
          },
          "decision": {
            "enum": [
              "pending",
              "accepted",
              "rejected",
              "deferred"
            ],
            "default": "pending"
          }
        }
      }
    },
    "can_nudge_root": {
      "type": "boolean",
      "default": false,
      "description": "Trunk only. True when this collection surfaced something that should move the root a LITTLE — never against the DNA, only sharpening it. Still requires Laura's decision via Matrix Feedback; this flag only marks that the sap is flowing downward."
    },
    "parent": {
      "type": "string",
      "description": "For a subcategory, the category it belongs to (cat.lifestyle, cat.photoshoot, cat.render_3d). For a content_type, the subcategory or category it runs under."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layer": {
            "const": "trunk"
          }
        },
        "required": [
          "layer"
        ]
      },
      "then": {
        "required": [
          "references"
        ],
        "properties": {
          "references": {
            "items": {
              "required": [
                "file",
                "role",
                "illustrates",
                "verdict"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layer": {
            "enum": [
              "category",
              "subcategory",
              "content_type"
            ]
          }
        },
        "required": [
          "layer"
        ]
      },
      "then": {
        "properties": {
          "can_nudge_root": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layer": {
            "const": "subcategory"
          }
        },
        "required": [
          "layer"
        ]
      },
      "then": {
        "required": [
          "parent"
        ]
      }
    }
  ]
}
